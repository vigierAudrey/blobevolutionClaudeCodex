# Database
# Développement local (sans SSL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blobinfini

# Production (OBLIGATOIRE: sslmode=require pour chiffrement + connection pooling)
# Format: postgresql://user:password@host:port/database?sslmode=require&connection_limit=20&pool_timeout=20&connect_timeout=10
#
# Paramètres recommandés :
# - sslmode=require : Chiffrement SSL obligatoire (sécurité)
# - connection_limit=20 : Nombre max de connexions dans le pool (défaut Prisma: 10, recommandé prod: 15-25)
# - pool_timeout=20 : Temps max d'attente (en secondes) pour obtenir une connexion du pool
# - connect_timeout=10 : Temps max (en secondes) pour établir la connexion initiale à PostgreSQL
#
# Impact : Avec 20 connexions, l'API peut gérer ~2000 requêtes/min sans erreur "too many connections"
# L'API refusera de démarrer en production sans sslmode=require
#
# DATABASE_URL=postgresql://user:password@production-host:5432/blobinfini?sslmode=require&connection_limit=20&pool_timeout=20&connect_timeout=10

REDIS_PASSWORD=change-me-strong
REDIS_URL=redis://default:change-me-strong@redis:6379/0
TWO_FACTOR_SECRET=change-me-2fa-secret-production

# IP Hashing (Privacy-by-Design / RGPD Compliant)
# Utilisé pour hasher les IPs avant stockage en BDD et logs (HMAC-SHA256)
# CRITIQUE: Doit être DIFFÉRENT de TWO_FACTOR_SECRET (séparation des secrets)
# Production: Générer un secret fort aléatoire (min 32 caractères)
# L'API refusera de démarrer en production si absent ou valeur par défaut
IP_HASH_SECRET=change-me-strong-ip-hash-secret-production-min-32-chars

# Email Hashing (Privacy-by-Design / anti-enumeration)
# Utilisé pour hasher les emails sensibles avant stockage technique (ex: brute-force / login attempts)
# CRITIQUE: Obligatoire même en dev, doit être FORT (min 32 caractères) et DIFFÉRENT de IP_HASH_SECRET
# L'API refusera de démarrer si absent OU si ce placeholder n'a pas été remplacé
EMAIL_HASH_SECRET=change-me-strong-email-hash-secret-production-min-32-chars

JWT_SECRET=please-change-in-dev
JWT_REFRESH_SECRET=please-change-in-dev-refresh
PORT=4000
NODE_ENV=development
# ⚠️ PROD: doit être `true` pour bloquer les comptes non vérifiés (cf. docs/deployment.md)
AUTH_REQUIRE_VERIFIED=false
PRIMARY_ADMIN_EMAILS=dev+admin@test.com
AUDIT_LOG_RETENTION_DAYS=365

# Trust Proxy Mode - Contrôle comment l'IP client est extraite (SÉCURITÉ CRITIQUE)
# Modes disponibles:
#  - disabled (défaut): N'utilise PAS X-Forwarded-For (prévient IP spoofing, recommandé si pas de proxy)
#  - loopback: Trust proxy SEULEMENT si connexion depuis localhost (dev local)
#  - ips: Trust proxy configuré avec TRUSTED_PROXY_IPS (OBLIGATOIRE: définir liste IPs/CIDR ci-dessous)
#  - true: Trust tous les proxies (DANGEREUX - jamais en production!)
#
# Production: Utiliser "ips" + définir TRUSTED_PROXY_IPS
# Dev local: Utiliser "loopback" ou "disabled"
# TRUST_PROXY_MODE=disabled

# Production: Liste d'IPs/CIDR de confiance pour les reverse proxies
# Format: IP1,IP2,CIDR1 (comma-separated)
#
# Déploiement Caddy+Cloudflare (docker-compose.vps.yml, réseau blobsurf_net 172.21.0.0/16) :
#   TRUSTED_PROXY_IPS=172.21.0.0/16
#   Caddy forward CF-Connecting-IP ; l'API valide l'IP Cloudflare edge via les CIDR intégrés
#   puis utilise CF-Connecting-IP comme IP canonique pour le rate limiting.
#
# Clever Cloud: TRUSTED_PROXY_IPS=10.2.0.0/16,172.31.0.0/16
# OBLIGATOIRE si TRUST_PROXY_MODE=ips (l'API refusera de démarrer sans cette variable)
# TRUSTED_PROXY_IPS=172.21.0.0/16

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3002

# SMTP (optionnel pour envoi d’emails)
# Valeurs par défaut pour Mailpit (dev):
#  - UI: http://localhost:${MAILPIT_HOST_PORT:-8025}
#  - SMTP: localhost:1025 (sans auth)
# Si une autre stack Docker occupe déjà le port 8025 (ex: stack VPS locale),
# surcharger uniquement le port UI : MAILPIT_HOST_PORT=8026
# NE PAS changer SMTP_PORT ici — l’API Docker se connecte à mailpit:1025 en réseau interne.
MAILPIT_HOST_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@localhost
SMTP_ALLOW_NO_AUTH=true # Permet l'envoi sans login/password (Mailpit en dev)

# S3 / MinIO (dev)
# Si une autre stack Docker occupe déjà 9000/9001 (ex: pre-VPS locale),
# surcharger MINIO_HOST_PORT et MINIO_CONSOLE_PORT, et adapter S3_* en conséquence.
# NE PAS changer le port interne 9000 dans S3_ENDPOINT (réseau Docker interne).
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=blobinfini-dev
S3_PUBLIC_URL_BASE=http://localhost:9000/blobinfini-dev
# Ajoute l'origin MinIO à la CSP img-src Next.js (csp.ts lit NEXT_PUBLIC_MEDIA_URL)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000

# Google AdSense (pour publicités)
# Obtenir sur: https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ENABLED=true

# Monitoring Production
# Utilise les logs Clever Cloud intégrés (gratuit)

# Optional: enable AI summaries for worklog
# Provide one of these keys to allow `npm run worklog:end -- --ai` to summarize
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ─────────────────────────────────────────────────────
# AUTH / SESSION (obligatoires en production)
# ─────────────────────────────────────────────────────

# Secret de signature des cookies de session Express.
# Dev : une valeur faible est tolérée (warning loggué).
# Production : min 32 chars aléatoires. L'API crash si absent en prod.
SESSION_SECRET=change-me-dev-session-secret-min-32-chars

# Secret de pseudonymisation des acteurs dans les logs d'audit.
# CRITIQUE : doit être DIFFÉRENT de JWT_SECRET et des autres secrets.
# Insecure default 'blobinfini-dev-log-actor-secret' bloque le démarrage en prod.
LOG_ACTOR_SECRET=change-me-dev-log-actor-secret-min-32-chars

# Sel HMAC pour l'anonymisation GDPR (export, purge, archivage booking).
# A un défaut dev ('blobinfini-gdpr-salt') mais doit être fort en prod.
# ANONYMIZATION_SALT=change-me-gdpr-anonymization-salt-min-32-chars

# 2FA obligatoire (true en production, false autorisé en dev)
# ⚠️  PROD: doit être `true` — l'API bloque au démarrage si false en prod.
AUTH_REQUIRE_2FA=false

# Coût bcrypt pour le hachage des mots de passe (défaut: 12).
# Augmenter en prod si les performances le permettent (12–14).
# BCRYPT_COST=12

# ─────────────────────────────────────────────────────
# CORS / COOKIES
# ─────────────────────────────────────────────────────

# Origines autorisées pour les requêtes cross-origin (CORS).
# Format: liste CSV sans espaces.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3010

# Domaine des cookies (obligatoire en production multi-sous-domaine).
# Exemple prod: COOKIE_DOMAIN=.blobinfini.app
# En dev: laisser vide (cookie scopé à localhost).
# COOKIE_DOMAIN=

# Mode CSP : 'enforce' (défaut) ou 'report-only' pour debug.
# CSP_REPORT_ONLY=false

# ─────────────────────────────────────────────────────
# 2FA — TUNING (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# TWO_FACTOR_MAX_CONCURRENT_CHALLENGES=3
# TWO_FACTOR_MAX_ATTEMPTS_USER=5
# TWO_FACTOR_MAX_ATTEMPTS_IP=20
# TWO_FACTOR_MAX_ATTEMPTS_USER_IP=5

# ─────────────────────────────────────────────────────
# ANALYTICS (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# Sel HMAC pour l'anonymisation des fingerprints analytics.
# Défaut dev : 'blobinfini-analytics-dev-salt' (à changer en prod).
# ANALYTICS_HASH_SALT=change-me-analytics-hash-salt

# Sel pour le rate-limiting analytics par IP hashée.
# ANALYTICS_RATE_LIMIT_SALT=change-me-analytics-rate-limit-salt

# Rétention des événements analytics bruts (défaut: 90 jours).
# ANALYTICS_EVENT_RETENTION_DAYS=90
# ANALYTICS_DAILY_AGG_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────
# JOBS DE PURGE RGPD (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# Intervalle de la purge GDPR en heures (défaut: 24h = quotidien).
# GDPR_PURGE_INTERVAL_HOURS=24
# Exécuter la purge au démarrage de l'API (défaut: false).
# GDPR_PURGE_RUN_ON_START=false

# Rétention des conversations archivées (défaut: 90 jours).
# CONV_TRASH_RETENTION_DAYS=90
# Intervalle de purge conversations en heures (défaut: 0 = désactivé).
# CONV_PURGE_INTERVAL_HOURS=24

# Rétention consent legacy (défaut: 730 jours = ~24 mois).
# CONSENT_PURGE_RETENTION_DAYS=730
# CONSENT_PURGE_INTERVAL_HOURS=0
# CONSENT_PURGE_RUN_ON_START=false

# Export vérifié requis avant purge des audit logs (défaut: true = sécurisé).
# AUDIT_LOG_PURGE_REQUIRES_VERIFIED_EXPORT=true

# ─────────────────────────────────────────────────────
# MATCHING — TUNING (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# Quota de décisions par utilisateur (défaut: pas de quota).
# MATCHING_DECISIONS_QUOTA_MAX=500
# Fenêtre du quota en heures (défaut: 24h).
# MATCHING_DECISIONS_QUOTA_WINDOW_HOURS=24
# Paires max par commit (défaut: 50, min prod: 5).
# MATCHING_POST_COMMIT_PAIR_LIMIT=50

# ─────────────────────────────────────────────────────
# WEBSOCKET — TUNING (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# Utiliser l'adaptateur Redis pour WebSocket (multi-instance).
# Activer en production avec plusieurs répliques.
# WS_ADAPTER_REDIS=false

# Connexions WebSocket max par IP (défaut: 50) et par user (défaut: 10).
# WS_MAX_CONN_PER_IP=50
# WS_MAX_CONN_PER_USER=10

# Cache d'authentification WebSocket (défaut: activé).
# WS_AUTH_CACHE_ENABLED=true
# WS_AUTH_CACHE_TTL_MS=60000

# Rate-limit WebSocket global (défaut: activé en prod, désactivé en dev).
# ENABLE_WEBSOCKET_RATE_LIMIT=true

# Rate-limit pré-authentification WebSocket.
# WS_PREAUTH_RL_ENABLED=true
# WS_PREAUTH_RL_POINTS=10
# WS_PREAUTH_RL_WINDOW_MS=60000

# ─────────────────────────────────────────────────────
# ADMIN — TUNING (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# TTL des sessions admin en heures (défaut: 8h, max prod: 24h).
# ADMIN_REFRESH_TTL_HOURS=8
# Forcer la vérification IP pour les admins (défaut: true).
# ADMIN_ENFORCE_ALLOWED_IPS=true
# Exiger step-up auth pour opérations sensibles (défaut: true en prod).
# ADMIN_REQUIRE_STEP_UP=true
# Cache des stats admin (défaut: activé, TTL: 120s).
# ADMIN_STATS_CACHE_ENABLED=true
# ADMIN_STATS_CACHE_TTL_SECONDS=120

# ─────────────────────────────────────────────────────
# BRUTE-FORCE — TUNING (optionnel, valeurs par défaut sûres)
# ─────────────────────────────────────────────────────

# Seuils brute-force (défauts : email=5, ip=20, TTL=86400s).
# BF_EMAIL_THRESHOLD=5
# BF_IP_THRESHOLD=20
# BF_EMAIL_TTL_SECONDS=86400
# BF_IP_TTL_SECONDS=86400
# BF_SUSPECT_EMAIL_TTL_SECONDS=3600
# BF_SUSPECT_IP_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────
# MONITORING / OBSERVABILITÉ
# ─────────────────────────────────────────────────────

# Token d'accès à l'endpoint /internal/metrics (recommandé en prod).
# Si absent, l'accès est restreint au cookie admin.
# METRICS_INTERNAL_TOKEN=change-me-metrics-token

# Token pour le monitoring sécurité interne.
# SECURITY_MONITOR_TOKEN=change-me-security-monitor-token

# ─────────────────────────────────────────────────────
# FIREBASE — Push Notifications (optionnel si feature désactivée)
# ─────────────────────────────────────────────────────
# Obtenir les credentials dans la console Firebase > Paramètres du projet > Comptes de service

# Credentials API serveur (backend)
# FIREBASE_PROJECT_ID=my-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@my-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n"

# Config SDK web (frontend — valeurs publiques, sûres à exposer)
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXX
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-firebase-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNtXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────
# BLOBOSPHERE — Intégration GitHub (optionnel)
# ─────────────────────────────────────────────────────
# Feature flags : désactivés par défaut (false).
# Activer UNIQUEMENT si l'intégration GitHub est configurée.
BLOBOSPHERE_AUTO_COMMIT=false
BLOBOSPHERE_GITHUB_PUSH=false

# GitHub App credentials (requis uniquement si BLOBOSPHERE_GITHUB_PUSH=true)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXX\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_REPO_OWNER=my-org
# GITHUB_REPO_NAME=my-repo
# GITHUB_DEFAULT_BASE_BRANCH=main
# GITHUB_MODE=app

# ─────────────────────────────────────────────────────
# FRONTEND WEB — Variables publiques supplémentaires
# ─────────────────────────────────────────────────────

# URL publique du site (utilisée pour les liens dans les emails, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Intervalle de polling des messages non lus en ms (défaut: 30000).
# NEXT_PUBLIC_UNREAD_POLL_MS=30000

# Slots AdSense par zone (optionnel — publicités désactivées si absents).
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_LEFT=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_RIGHT=0987654321
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_MOBILE=1122334455
# NEXT_PUBLIC_ADSENSE_SLOT_BLOBOSPHERE_LEFT=5544332211
# NEXT_PUBLIC_ADSENSE_SLOT_BLOBOSPHERE_RIGHT=6677889900
# NEXT_PUBLIC_ADSENSE_SLOT_BLOBOSPHERE_MOBILE=9988776655
