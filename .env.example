DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blobinfini
REDIS_URL=redis://localhost:6379
JWT_SECRET=please-change-in-dev
JWT_REFRESH_SECRET=please-change-in-dev-refresh
PORT=4000
NODE_ENV=development
AUTH_REQUIRE_VERIFIED=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3001

# SMTP (optionnel pour envoi d’emails)
# Valeurs par défaut pour Mailpit (dev):
#  - UI: http://localhost:8025
#  - SMTP: localhost:1025 (sans auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@localhost
SMTP_ALLOW_NO_AUTH=true # Permet l'envoi sans login/password (Mailpit en dev)

# S3 / MinIO (dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=blobinfini-dev
S3_PUBLIC_URL_BASE=http://localhost:9000/blobinfini-dev

# Optional: enable AI summaries for worklog
# Provide one of these keys to allow `npm run worklog:end -- --ai` to summarize
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
