# .env.vps.example — Environnement VPS Runtime BlobSurf
#
# Modele versionnable uniquement : copier vers .env.vps puis remplir sur le VPS.
# Le vrai .env.vps reste local au VPS et ne doit JAMAIS etre commite.
# Ne mettre ici que des placeholders non secrets.
# Mailpit est reserve au local/test ; en VPS/prod, la cible email doit etre Brevo.
#
# Générer les secrets forts :
#   ./scripts/generate-secrets.sh --pre-vps >> .env.vps
#   (les secrets ont la même structure qu'en pre-vps)
#
# Lancer le bootstrap complet :
#   ./scripts/vps-bootstrap.sh
#
# Différences clés avec .env.pre-vps.example :
#   - APP_ENV=vps (remplace pre-vps)
#   - STORAGE_DOMAIN : domaine public du stockage objet (proxy MinIO)
#   - S3_PRESIGN_ENDPOINT : URL HTTPS publique (jamais localhost)
#   - S3_PUBLIC_URL_BASE  : idem
#   - S3_PRESIGN_ENDPOINT ne contient plus localhost → MinIO n'est pas exposé

# ─── Garde anti-confusion d'environnement ────────────────────────────────────
APP_ENV=vps
NODE_ENV=production

# ─── Domaines publics ─────────────────────────────────────────────────────────
# Changer *.blobinfini.local → votre domaine réel pour un déploiement VPS public.
# Ex (blobsurf.com) : API_DOMAIN=api.blobsurf.com, APP_DOMAIN=blobsurf.com, STORAGE_DOMAIN=storage.blobsurf.com
API_DOMAIN=api.blobinfini.local
APP_DOMAIN=app.blobinfini.local
# STORAGE_DOMAIN : domaine de stockage objet derrière Caddy (blobsurf) ou nginx (vps).
# MinIO est accessible UNIQUEMENT via ce domaine (aucun port exposé directement).
# Doit correspondre à MINIO_SERVER_URL dans docker-compose.blobsurf.yml / docker-compose.vps.yml.
STORAGE_DOMAIN=storage.blobinfini.local

# ─── Caddy (stack blobsurf uniquement — docker-compose.blobsurf.yml) ──────────
# Email pour Let's Encrypt. Obligatoire si vous utilisez docker-compose.blobsurf.yml.
# Optionnel pour docker-compose.vps.yml (nginx avec mkcert ou certbot externe).
CADDY_ACME_EMAIL=you@example.com

# ─── Base de données (réseau Docker interne — pas de SSL inter-containers) ───
POSTGRES_USER=blobinfini_vps
POSTGRES_PASSWORD=CHANGEME_fort_32chars_minimum
POSTGRES_DB=blobinfini_vps
# DATABASE_URL est injecté par docker-compose depuis les vars ci-dessus.

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_redis_fort_32chars

# ─── Secrets d'authentification (TOUS obligatoires, TOUS distincts) ───────────
SESSION_SECRET=CHANGEME_session_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=CHANGEME_jwt_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGEME_jwt_refresh_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxx
TWO_FACTOR_SECRET=CHANGEME_2fa_secret_32chars_minimum_xxxxxxxxxx
IP_HASH_SECRET=CHANGEME_ip_hash_secret_32chars_minimum_xxxxxxxxxx_different_from_2fa
CONSENT_WRITE_SECRET=CHANGEME_consent_write_secret_64chars_minimum_xxxxxxxxxxxxxxxxxx
LOG_ACTOR_SECRET=CHANGEME_log_actor_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Trust proxy ─────────────────────────────────────────────────────────────
# Sous-réseau du container proxy → ajuster selon la stack utilisée.
#   docker-compose.vps.yml    (nginx)  : 172.21.0.0/16
#   docker-compose.blobsurf.yml (Caddy): 172.22.0.0/16
TRUST_PROXY_MODE=ips
TRUSTED_PROXY_IPS=172.22.0.0/16

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Domaine du frontend (sans trailing slash). Exemples :
#   docker-compose.vps.yml    : https://app.blobinfini.local
#   docker-compose.blobsurf.yml (blobsurf.com) : https://blobsurf.com
ALLOWED_ORIGINS=https://blobsurf.com

# ─── Auth ──────────────────────────────────────────────────────────────────────
AUTH_REQUIRE_2FA=true
AUTH_REQUIRE_VERIFIED=true
LOGINATTEMPT_STORE_PLAINTEXT_EMAIL=false

# ─── Admin ────────────────────────────────────────────────────────────────────
PRIMARY_ADMIN_EMAILS=admin@example.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.blobinfini.local
WEB_BASE_URL=https://app.blobinfini.local

# ─── SMTP / Brevo (OBLIGATOIRE en VPS réel) ──────────────────────────────────
# Cible imposée en VPS/pré-prod réelle : Brevo SMTP relay.
# Aucun fallback Mailpit/localhost n'est autorisé ici.
# Brevo TLS explicite :
#   - port 587  => SMTP_SECURE=false
#   - port 465  => SMTP_SECURE=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASS=change-me
SMTP_SECURE=false
SMTP_FROM=no-reply@blobsurf.com

# ─── S3 / MinIO — DIFFÉRENCES CRITIQUES VPS ──────────────────────────────────
#
# ARCHITECTURE VPS :
#   S3_ENDPOINT      : API → MinIO (interne Docker, inchangé)
#   S3_PRESIGN_ENDPOINT : URL présignée vue par le NAVIGATEUR (via nginx TLS)
#   S3_PUBLIC_URL_BASE  : URL de base pour les assets publics (via nginx TLS)
#
# ⚠️  INTERDIT : localhost dans S3_PRESIGN_ENDPOINT ou S3_PUBLIC_URL_BASE
#     → vps-bootstrap.sh et smoke-test-vps.sh rejettent ces valeurs
#
# Cohérence requise :
#   S3_PRESIGN_ENDPOINT == https://$STORAGE_DOMAIN
#   S3_PUBLIC_URL_BASE  == https://$STORAGE_DOMAIN/$S3_BUCKET
#   MINIO_SERVER_URL (docker-compose.vps.yml) == https://$STORAGE_DOMAIN
#
# Politique bucket : GET anonyme (lecture publique), pas de liste, écriture par présignés uniquement.
# Policy définie par vps-bootstrap.sh via mc (MinIO Client).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vps-access-key
S3_SECRET_ACCESS_KEY=CHANGEME_minio_secret_32chars_minimum
S3_BUCKET=blobinfini-vps
# Ces deux valeurs sont injectées par docker-compose.vps.yml depuis STORAGE_DOMAIN + S3_BUCKET.
# Les définir ici uniquement si vous n'utilisez pas docker-compose.vps.yml.
# S3_PRESIGN_ENDPOINT=https://storage.blobinfini.local
# S3_PUBLIC_URL_BASE=https://storage.blobinfini.local/blobinfini-vps

# ─── Chemin des certs TLS ─────────────────────────────────────────────────────
# Local (mkcert) : ./docker/certs/vps/
# Production (Let's Encrypt) : /etc/letsencrypt/live/ ou chemin symlinks certbot
VPS_CERTS_DIR=./docker/certs/vps

# ─── Observabilité ────────────────────────────────────────────────────────────
METRICS_INTERNAL_TOKEN=CHANGEME_metrics_token_32chars_minimum
SECURITY_MONITOR_TOKEN=CHANGEME_security_monitor_token_32chars
SENTRY_DSN=

# ─── GDPR / Rétention ────────────────────────────────────────────────────────
GDPR_PURGE_INTERVAL_HOURS=24
CONV_TRASH_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# ─── CSP ──────────────────────────────────────────────────────────────────────
CSP_REPORT_ONLY=true

# ─── Divers ───────────────────────────────────────────────────────────────────
PORT=4000
ADMIN_REFRESH_TTL_HOURS=8

# ─── Backup chiffrement (age) ─────────────────────────────────────────────────
# Générer la paire de clés : ./scripts/setup-backup-keys.sh
# La clé PRIVÉE ne doit JAMAIS être sur le VPS (stocker dans password manager).
# Seule la clé publique (BACKUP_AGE_RECIPIENT) est ici — safe même si .env.vps est lu.
BACKUP_AGE_RECIPIENT=age1CHANGEME_generer_via_setup-backup-keys.sh

# ─── Backup Cloudflare R2 ─────────────────────────────────────────────────────
# Remote rclone configuré via : rclone config (remote name : r2-backups)
# Bucket R2 : créé dans le dashboard Cloudflare
RCLONE_REMOTE=r2-backups
R2_BUCKET=blobsurf-vps-backups

# Rétention R2 (nombre de fichiers chiffrés à conserver)
R2_RETAIN_PG=30
R2_RETAIN_MINIO=14

# Discord (déjà utilisé par alert.sh — rappel ici pour clarté)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
