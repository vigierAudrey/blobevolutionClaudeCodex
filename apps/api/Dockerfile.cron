# Dockerfile pour le service cron de nettoyage GDPR
FROM node:20-alpine

# Installer cron
RUN apk add --no-cache dcron

WORKDIR /app

# Copier les fichiers de manifeste (racine + workspaces nécessaires)
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/database/prisma packages/database/prisma

# Installer les dépendances (toutes boutiques pour garantir @blobinfini/database)
RUN npm ci && npm install -g ts-node typescript

# Copier le reste du code
COPY . .

# Générer le client Prisma du package database
WORKDIR /app/packages/database
RUN npx prisma generate

# Préparer l'app API (scripts + logs + crontab)
WORKDIR /app/apps/api
RUN mkdir -p /app/apps/api/logs \
  && chmod +x /app/apps/api/scripts/*.sh \
  && cp /app/apps/api/crontab /etc/crontabs/root

# Commande pour démarrer cron en foreground
CMD ["crond", "-f", "-l", "2"]
