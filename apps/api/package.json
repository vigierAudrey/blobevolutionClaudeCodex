{
  "name": "@blobinfini/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "NODE_ENV=test jest",
    "test:unit": "NODE_ENV=test jest --config jest.unit.config.cjs",
    "test:matching": "NODE_ENV=test jest --config jest.matching.config.cjs",
    "gdpr:report": "tsx src/scripts/gdpr-purge-cli.ts report",
    "gdpr:purge": "tsx src/scripts/gdpr-purge-cli.ts purge",
    "gdpr:archive": "tsx src/scripts/gdpr-purge-cli.ts archive",
    "cleanup:phantom-riders": "tsx scripts/cleanup-phantom-rider-profiles.ts",
    "cleanup:phantom-riders:force": "tsx scripts/cleanup-phantom-rider-profiles.ts --force",
    "job:purge-notifications": "tsx src/jobs/purgeNotifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@blobinfini/database": "workspace:*",
"@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "connect-redis": "^9.0.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "nodemailer": "^9.0.1",
    "rate-limit-redis": "^5.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/nodemailer": "^6.4.15",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@typescript-eslint/type-utils": "^8.60.0",
    "@typescript-eslint/utils": "^8.59.3",
    "jest": "^30.2.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  }
}
