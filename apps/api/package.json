{
  "name": "@blobinfini/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "NODE_ENV=test jest",
    "gdpr:report": "tsx src/scripts/gdpr-purge-cli.ts report",
    "gdpr:purge": "tsx src/scripts/gdpr-purge-cli.ts purge",
    "gdpr:archive": "tsx src/scripts/gdpr-purge-cli.ts archive",
    "cleanup:phantom-riders": "tsx scripts/cleanup-phantom-rider-profiles.ts",
    "cleanup:phantom-riders:force": "tsx scripts/cleanup-phantom-rider-profiles.ts --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.616.0",
    "@aws-sdk/s3-request-presigner": "^3.616.0",
    "@blobinfini/database": "workspace:*",
    "@sentry/node": "^10.27.0",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "nodemailer": "^8.0.5",
    "rate-limit-redis": "^4.2.2",
    "rate-limiter-flexible": "^9.0.1",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/nodemailer": "^6.4.15",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/type-utils": "^7.18.0",
    "@typescript-eslint/utils": "^7.18.0",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  }
}
