# ===================================
# 🌐 Configuration Frontend (Vercel)
# ===================================

# API Backend URL (Clever Cloud en production, localhost en dev)
# En production Vercel, pointez vers votre API Clever Cloud
# Exemple prod: https://app-XXXXX-X.cleverapps.io
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site web (utilisée pour les liens de partage, SEO, etc.)
# En production Vercel, utilisez votre domaine Vercel ou custom
# Exemple: https://blobinfini.vercel.app ou https://votredomaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ===================================
# 🔥 Firebase Cloud Messaging (Push Notifications)
# ===================================
# Obtenez ces valeurs depuis la console Firebase:
# https://console.firebase.google.com/project/[votre-projet]/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===================================
# 📊 Google AdSense (Optionnel)
# ===================================
# Pour monétiser avec des publicités
# Obtenir sur: https://www.google.com/adsense/

NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ===================================
# 🗺️ Carte (OpenStreetMap via Leaflet)
# ===================================
# Pas de clé API nécessaire pour OSM/Leaflet
# Configuration déjà incluse dans le code

# ===================================
# 📈 Analytics (Optionnel)
# ===================================
# Pour suivre les statistiques d'utilisation

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics (alternative RGPD-friendly)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=blobinfini.com

# ===================================
# ⚙️ Configuration de développement
# ===================================

# Désactiver la télémétrie Next.js
NEXT_TELEMETRY_DISABLED=1

# Mode debug (affiche les logs détaillés)
# NEXT_PUBLIC_DEBUG=false

# ===================================
# 📝 Instructions pour Vercel
# ===================================
#
# 1. Connectez votre repo GitHub à Vercel
# 2. Dans les paramètres Vercel, ajoutez ces variables d'environnement:
#    - NEXT_PUBLIC_API_URL (URL de votre API Clever Cloud)
#    - NEXT_PUBLIC_SITE_URL (URL Vercel auto-générée ou domaine custom)
#    - Variables Firebase (si notifications push activées)
#
# 3. Vercel détectera automatiquement Next.js grâce à vercel.json
# 4. Le déploiement se fera automatiquement sur chaque push
#
# Pour déployer manuellement:
#   npm i -g vercel
#   cd apps/web
#   vercel login
#   vercel --prod
#
# ===================================
