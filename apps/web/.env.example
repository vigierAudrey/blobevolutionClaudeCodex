# ===================================
# 🌐 Configuration Frontend
# ===================================

# API Backend URL (localhost en dev, VPS en production)
# Exemple prod VPS: https://api.blobinfini.fr
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site web (utilisée pour les liens de partage, SEO, etc.)
# Exemple prod VPS: https://app.blobinfini.fr ou https://blobsurf.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ===================================
# 🔥 Firebase Cloud Messaging (Push Notifications)
# ===================================
# Variables PUBLIQUES (baked-in au build Next.js). Obtenez-les depuis la console Firebase :
# https://console.firebase.google.com/project/[votre-projet]/settings/general
#
# IMPORTANT :
# - Pour le staging push, utiliser un projet Firebase de TEST dédié (jamais le prod).
# - Les valeurs demo-* (demo-api-key, demo-vapid-key, blobinfini-demo, 123456789, …) sont
#   INTERDITES en staging avec push activé : le front est fail-closed et n'appellera pas
#   getToken tant que la config n'est pas réelle.
# - Ces variables sont publiques mais doivent correspondre au projet Firebase de test.
# - Laisser vide tant que le push n'est pas testé.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Clé publique Web Push (VAPID) — indispensable à l'abonnement du navigateur.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- NE JAMAIS mettre ces variables côté front (elles vivent UNIQUEMENT côté API) ---
# FIREBASE_PROJECT_ID=           (identifiant projet, côté API)
# FIREBASE_CLIENT_EMAIL=         (service account, secret serveur)
# FIREBASE_PRIVATE_KEY=          (SECRET SERVEUR CRITIQUE — clé privée, jamais committée)
# PUSH_NOTIFICATIONS_ENABLED=false  (flag d'activation réelle — reste false jusqu'au test contrôlé)

# ===================================
# 📊 Google AdSense (Optionnel)
# ===================================
# Pour monétiser avec des publicités
# Obtenir sur: https://www.google.com/adsense/

NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ===================================
# 🗺️ Carte (OpenStreetMap via Leaflet)
# ===================================
# Pas de clé API nécessaire pour OSM/Leaflet
# Configuration déjà incluse dans le code

# ===================================
# 📈 Analytics (Optionnel)
# ===================================
# Pour suivre les statistiques d'utilisation

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics (alternative RGPD-friendly)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=blobinfini.com

# ===================================
# ⚙️ Configuration de développement
# ===================================

# Désactiver la télémétrie Next.js
NEXT_TELEMETRY_DISABLED=1

# Mode debug (affiche les logs détaillés)
# NEXT_PUBLIC_DEBUG=false

# ===================================
# 📝 Instructions de déploiement
# ===================================
#
# 1. En local, gardez NEXT_PUBLIC_API_URL=http://localhost:4000.
# 2. En VPS, la valeur est injectée au build Docker via docker-compose.vps.yml
#    ou docker-compose.blobsurf.yml.
# 3. Ne commitez jamais .env.vps ni de secrets GitHub Actions.
#
# ===================================
