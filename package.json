{
  "name": "blobevolution-claude-codex",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.3.6"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:start",
    "dev:start": "pnpm run dev:all",
    "dev:kill-ports": "bash scripts/free-port.sh 4000 3002 3010 3011 3020",
    "dev:check:redis": "node -e \"const net=require('node:net');const warn='⚠️  Redis non démarré sur localhost:6379. Lance \\\"pnpm run dev:infra\\\" puis \\\"pnpm run dev\\\".';let done=false;const finish=(msg)=>{if(done)return;done=true;if(msg)console.warn(msg);process.exit(0);};const socket=net.connect({host:'127.0.0.1',port:6379});socket.setTimeout(600);socket.on('connect',()=>{socket.end();finish();});socket.on('timeout',()=>{socket.destroy();finish(warn);});socket.on('error',()=>finish(warn));\"",
    "dev:api:start": "pnpm --filter @blobinfini/database build && pnpm --filter @blobinfini/api dev",
    "dev:web:start": "pnpm --filter @blobinfini/web dev",
    "dev:api": "npx kill-port 4000 || true && pnpm run dev:api:start",
    "dev:web": "bash scripts/free-port.sh 3002 && pnpm run dev:web:start",
    "dev:all": "pnpm run dev:kill-ports && pnpm run dev:check:redis && npm-run-all -p dev:api:start dev:web:start",
    "dev:web:port": "node scripts/dev-web-port.mjs",
    "dev:web:nokill": "cd apps/web && cross-env-shell \"NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:4000} PORT=${PORT:-3010} npx next dev -p ${PORT:-3010}\"",
    "dev:infra": "docker compose up -d postgres redis minio mailpit",
    "dev:api:docker": "docker compose up api",
    "dev:all:docker": "pnpm run dev:infra && concurrently -n web,api -c magenta,blue \"pnpm run dev:web\" \"pnpm run dev:api:docker\"",
    "build": "pnpm --filter @blobinfini/api build && pnpm --filter @blobinfini/database build",
    "build:api": "pnpm --filter @blobinfini/api build",
    "build:web": "pnpm run db:generate && pnpm --filter @blobinfini/web build",
    "type-check": "pnpm --filter @blobinfini/api type-check && pnpm --filter @blobinfini/web type-check",
    "db:generate": "pnpm --filter @blobinfini/database generate",
    "db:migrate": "pnpm --filter @blobinfini/database migrate",
    "db:migrate:deploy": "pnpm --filter @blobinfini/database migrate:deploy",
    "db:preflight": "pnpm --filter @blobinfini/database exec prisma migrate status",
    "db:preflight:allow-pending": "pnpm --filter @blobinfini/database exec prisma migrate status || true",
    "db:migrate:nolock": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 pnpm --filter @blobinfini/database migrate",
    "db:studio": "pnpm --filter @blobinfini/database studio",
    "db:seed": "pnpm --filter @blobinfini/database seed",
    "db:seed:active-tests": "pnpm --filter @blobinfini/database seed:active-tests",
    "db:seed:pre-vps": "APP_ENV=pre-vps pnpm --filter @blobinfini/database seed:pre-vps",
    "pre-vps:bootstrap": "bash scripts/pre-vps-bootstrap.sh",
    "pre-vps:smoke": "bash scripts/smoke-test.sh",
    "pre-vps:check-env": "bash scripts/check-pre-vps-env.sh",
    "db:reset": "pnpm --filter @blobinfini/database reset",
    "db:reset:seedless": "pnpm --filter @blobinfini/database reset:seedless",
    "db:reseed": "pnpm --filter @blobinfini/database reseed",
    "db:reseed:active-tests": "pnpm --filter @blobinfini/database reseed:active-tests",
    "purge:consent-ip": "tsx apps/api/src/jobs/purgeConsent.ts",
    "test:security": "bash scripts/no-raw-ip-check.sh",
    "migrate:ip-to-hash": "tsx scripts/migrate-ip-to-hash-v2.ts --execute",
    "migrate:ip-to-hash:dry-run": "tsx scripts/migrate-ip-to-hash-v2.ts --dry-run",
    "test": "pnpm --filter @blobinfini/api test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:active-users:api": "pnpm --filter @blobinfini/api test -- --runTestsByPath src/modules/chat/__tests__/active-user-simulation.e2e.test.ts src/modules/chat/__tests__/active-user-abuse-controls.e2e.test.ts src/modules/auth/__tests__/active-user-login-rate-limit.e2e.test.ts src/lib/__tests__/socket-conversation-authz.test.ts src/lib/__tests__/socket-reconnection-storm.test.ts src/lib/__tests__/socket-sendmessage-burst-rl.test.ts src/lib/__tests__/socket-fanout-budget.test.ts src/lib/__tests__/socket-sendmessage-global-rl.test.ts",
    "test:active-users:bootstrap": "node scripts/run-e2e.mjs apps/web/tests/e2e/active-bootstrap.spec.ts",
    "test:active-users:e2e": "node scripts/run-e2e.mjs apps/web/tests/e2e/active-users.spec.ts",
    "test:active-users:load": "node scripts/run-active-user-load.mjs",
    "test:active-users": "npm-run-all db:reseed:active-tests test:active-users:api test:active-users:e2e",
    "postinstall": "patch-package",
    "prepare": "pnpm --filter @blobinfini/database generate && (pnpm --filter @blobinfini/database build || true)",
    "lint": "pnpm --filter @blobinfini/web lint",
    "lint:strict": "pnpm --filter @blobinfini/web lint:strict",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml",
    "storybook": "pnpm --filter @blobinfini/web storybook",
    "storybook:build": "pnpm --filter @blobinfini/web build-storybook",
    "storybook:test": "bash scripts/run-storybook-tests.sh",
    "fix:perms": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && rm -f pnpm-lock.yaml && pnpm store prune && pnpm install",
    "fix:perms:sudo": "sudo chown -R $(whoami) ~/.local/share/pnpm && sudo chown -R $(whoami) ./ && pnpm run fix:perms"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@redocly/cli": "^2.2.2",
    "@storybook/nextjs": "^8.6.15",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "get-port": "^7.1.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "storybook": "^8.6.17",
    "wait-on": "^9.0.1",
    "wait-port": "^1.1.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "framer-motion": "^12.23.18",
    "prismjs": "^1.30.0",
    "react-leaflet": "^4.2.1",
    "rehype-prism-plus": "^2.0.1"
  },
  "overrides": {
    "glob": "^10.3.6",
    "inflight": "npm:noop-package@1.0.0",
    "rimraf": "^6.0.1",
    "@mapbox/node-pre-gyp": "^2.0.0",
    "@humanwhocodes/config-array": "^0.13.0",
    "@humanwhocodes/object-schema": "^2.0.3",
    "eslint": "8.57.1",
    "abab": "npm:noop-package@1.0.0",
    "domexception": "npm:noop-package@1.0.0",
    "sourcemap-codec": "^1.4.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "next": "14.2.35",
    "styled-jsx": "5.1.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "7.18.0",
    "@typescript-eslint/type-utils": "7.18.0",
    "js-yaml": "^4.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
