{
  "name": "blobevolution-claude-codex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run build --workspace @blobinfini/database && npm run dev --workspace @blobinfini/api",
    "build": "npm run build --workspace @blobinfini/api && npm run build --workspace @blobinfini/database",
    "type-check": "tsc -p tsconfig.base.json && tsc -p apps/api/tsconfig.json",
    "db:generate": "npm run generate --workspace @blobinfini/database",
    "db:migrate": "npm run migrate --workspace @blobinfini/database",
    "db:studio": "npm run studio --workspace @blobinfini/database",
    "test": "npm run test --workspace @blobinfini/api",
    "postinstall": "npm run build --workspace @blobinfini/database || true"
  }
}
