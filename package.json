{
  "name": "blobevolution-claude-codex",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:start",
    "dev:start": "pnpm run dev:all",
    "dev:kill-ports": "(npx kill-port 4000 || true) && (npx kill-port 3002 || true) && (npx kill-port 3010 || true) && (npx kill-port 3011 || true) && (npx kill-port 3020 || true)",
    "dev:api:start": "pnpm --filter @blobinfini/database build && pnpm --filter @blobinfini/api dev",
    "dev:web:start": "pnpm --filter @blobinfini/web dev",
    "dev:api": "npx kill-port 4000 || true && pnpm run dev:api:start",
    "dev:web": "npx kill-port 3002 || true && pnpm run dev:web:start",
    "dev:all": "pnpm run dev:kill-ports && npm-run-all -p dev:api:start dev:web:start",
    "dev:web:port": "node scripts/dev-web-port.mjs",
    "dev:web:nokill": "cd apps/web && cross-env-shell \"NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:4000} PORT=${PORT:-3010} npx next dev -p ${PORT:-3010}\"",
    "dev:infra": "docker compose up -d postgres redis minio mailpit",
    "dev:api:docker": "docker compose up api",
    "dev:all:docker": "pnpm run dev:infra && concurrently -n web,api -c magenta,blue \"pnpm run dev:web\" \"pnpm run dev:api:docker\"",
    "build": "pnpm --filter @blobinfini/api build && pnpm --filter @blobinfini/database build",
    "build:api": "pnpm --filter @blobinfini/api build",
    "build:web": "pnpm run db:generate && pnpm --filter @blobinfini/web build",
    "type-check": "pnpm --filter @blobinfini/api type-check && pnpm --filter @blobinfini/web type-check",
    "type-check:legacy": "tsc -p tsconfig.base.json && tsc -p apps/api/tsconfig.json",
    "//": "⚠️  DO NOT use type-check:legacy in CI. Use workspace-specific scripts instead: pnpm --filter @blobinfini/web type-check && pnpm --filter @blobinfini/api type-check",
    "db:generate": "pnpm --filter @blobinfini/database generate",
    "db:migrate": "pnpm --filter @blobinfini/database migrate",
    "db:migrate:deploy": "pnpm --filter @blobinfini/database migrate:deploy",
    "db:migrate:nolock": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 pnpm --filter @blobinfini/database migrate",
    "db:studio": "pnpm --filter @blobinfini/database studio",
    "db:seed": "pnpm --filter @blobinfini/database seed",
    "db:reset": "pnpm --filter @blobinfini/database reset",
    "db:reset:seedless": "pnpm --filter @blobinfini/database reset:seedless",
    "db:reseed": "pnpm --filter @blobinfini/database reseed",
    "purge:consent-ip": "tsx apps/api/src/jobs/purgeConsent.ts",
    "test:security": "bash scripts/no-raw-ip-check.sh",
    "migrate:ip-to-hash": "tsx scripts/migrate-ip-to-hash-v2.ts --execute",
    "migrate:ip-to-hash:dry-run": "tsx scripts/migrate-ip-to-hash-v2.ts --dry-run",
    "test": "pnpm --filter @blobinfini/api test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "postinstall": "patch-package",
    "prepare": "(cd packages/database && npx prisma generate) && (pnpm --filter @blobinfini/database build || true)",
    "lint": "pnpm --filter @blobinfini/web lint",
    "lint:strict": "pnpm --filter @blobinfini/web lint:strict",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml",
    "storybook": "pnpm --filter @blobinfini/web storybook",
    "storybook:build": "pnpm --filter @blobinfini/web build-storybook",
    "storybook:test": "bash scripts/run-storybook-tests.sh",
    "fix:perms": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && rm -f pnpm-lock.yaml && pnpm store prune && pnpm install",
    "fix:perms:sudo": "sudo chown -R $(whoami) ~/.local/share/pnpm && sudo chown -R $(whoami) ./ && pnpm run fix:perms"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@redocly/cli": "^2.2.2",
    "@storybook/nextjs": "^8.6.15",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "get-port": "^7.1.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "storybook": "^8.6.15",
    "wait-on": "^9.0.1",
    "wait-port": "^1.1.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "framer-motion": "^12.23.18",
    "prismjs": "^1.30.0",
    "react-leaflet": "^4.2.1",
    "rehype-prism-plus": "^2.0.1"
  },
  "overrides": {
    "glob": "^10.3.6",
    "inflight": "npm:noop-package@1.0.0",
    "rimraf": "^6.0.1",
    "@mapbox/node-pre-gyp": "^2.0.0",
    "@humanwhocodes/config-array": "^0.13.0",
    "@humanwhocodes/object-schema": "^2.0.3",
    "eslint": "8.57.1",
    "abab": "npm:noop-package@1.0.0",
    "domexception": "npm:noop-package@1.0.0",
    "sourcemap-codec": "^1.4.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "next": "14.2.35",
    "styled-jsx": "5.1.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "7.18.0",
    "@typescript-eslint/type-utils": "7.18.0",
    "js-yaml": "^4.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
