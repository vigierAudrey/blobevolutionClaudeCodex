{
  "name": "blobevolution-claude-codex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run build --workspace @blobinfini/database && npm run dev --workspace @blobinfini/api",
    "dev:web": "npm run dev --workspace @blobinfini/web",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --workspace @blobinfini/api && npm run build --workspace @blobinfini/database",
    "type-check": "tsc -p tsconfig.base.json && tsc -p apps/api/tsconfig.json",
    "db:generate": "npm run generate --workspace @blobinfini/database",
    "db:migrate": "npm run migrate --workspace @blobinfini/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace @blobinfini/database",
    "db:migrate:nolock": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 npm run migrate --workspace @blobinfini/database",
    "db:studio": "npm run studio --workspace @blobinfini/database",
    "db:seed": "npm run seed --workspace @blobinfini/database",
    "db:reset": "npm run reset --workspace @blobinfini/database",
    "db:reset:seedless": "npm run reset:seedless --workspace @blobinfini/database",
    "db:reseed": "npm run reseed --workspace @blobinfini/database",
    "purge:consent-ip": "tsx apps/api/src/jobs/purgeConsent.ts",
    "test": "npm run test --workspace @blobinfini/api",
    "test:e2e": "playwright test",
    "postinstall": "(cd packages/database && npx prisma generate) && (npm run build --workspace @blobinfini/database || true) && patch-package",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml",
    "storybook": "npm run storybook --workspace @blobinfini/web",
    "storybook:build": "npm run build-storybook --workspace @blobinfini/web",
    "storybook:test": "bash scripts/run-storybook-tests.sh",
    "fix:perms": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && rm -f package-lock.json apps/*/package-lock.json packages/*/package-lock.json && npm cache clean --force && npm install",
    "fix:perms:sudo": "sudo chown -R $(whoami) ~/.npm && sudo chown -R $(whoami) ./ && npm run fix:perms"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@redocly/cli": "^2.2.2",
    "@storybook/nextjs": "^8.6.14",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "storybook": "^8.6.14",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "framer-motion": "^12.23.18",
    "react-leaflet": "^4.2.1"
  },
  "overrides": {
    "glob": "^10.0.0",
    "inflight": "npm:noop-package@1.0.0",
    "rimraf": "^6.0.1",
    "@mapbox/node-pre-gyp": "^2.0.0",
    "@humanwhocodes/config-array": "^0.14.0",
    "@humanwhocodes/object-schema": "^2.0.3",
    "eslint": "^9.0.0",
    "abab": "npm:noop-package@1.0.0",
    "domexception": "npm:noop-package@1.0.0",
    "sourcemap-codec": "^1.4.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "next": "14.1.4",
    "styled-jsx": "5.1.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "7.18.0",
    "@typescript-eslint/type-utils": "7.18.0"
  }
}
