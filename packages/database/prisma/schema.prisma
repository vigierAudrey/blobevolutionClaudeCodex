generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  role                    Role                     @default(RIDER)
  emailVerified           Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  consentedAt             DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  consentVersion          String?
  consentIp               String?
  consentIpHash           String?                  // HMAC-SHA256 hash of consentIp (RGPD compliant, 24 hex chars)
  adminProfile            AdminProfile?
  conversationMembers     ConversationMember[]
  emailVerificationTokens EmailVerificationToken[]
  lastSearch              LastSearch?
  matchesA                Match[]                  @relation("UserOne")
  matchesB                Match[]                  @relation("UserTwo")
  decisions               MatchDecision[]          @relation("UserAsActor")
  messages                Message[]
  passwordResetTokens     PasswordResetToken[]
  proProfile              ProProfile?
  reports                 ProfileReport[]          @relation("UserAsReporter")
  refreshTokens           RefreshToken[]
  riderProfile            RiderProfile?
  sessions                Session[]
  contactRequests         ContactRequest[]         @relation("ProContactRequests")
  contactResponses        ContactRequestResponse[] @relation("RiderContactResponses")
  proAvailabilities       ProAvailability[]        @relation("ProAvailabilityOnUser")
  proOfferClicks          ProOfferClick[]
  bookingRequests         BookingRequest[]         @relation("BookingRequestOnUser")
  bookings                Booking[]                @relation("BookingOnUser")
  availabilityInteractions ProAvailabilityInteraction[] @relation("RiderAvailabilityInteractions")
  auditLogs              AuditLog[]
  pushTokens             PushToken[]
  notificationPreferences NotificationPreferences?
  loginAttempts          LoginAttempt[]
  createdAlerts          SystemAlert[]            @relation("UserSystemAlerts")
  conversationInvitations ConversationInvitation[] @relation("InvitedToConversation")
  sentConversationInvitations ConversationInvitation[] @relation("ConversationInviter")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  ipHash    String?  // HMAC-SHA256 hash of ip (RGPD compliant, 24 hex chars)
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ip])
  @@index([ipHash])
  @@index([createdAt])
  @@index([success])
}

model LastSearch {
  userId     String       @id
  sport      String
  level      String
  distanceKm Int?
  lat        Float?
  lng        Float?
  date       DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model RiderProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  displayName       String?
  bio               String?
  sex               Sex               @default(UNSPECIFIED)
  maxDistanceKm     Int               @default(20)
  emailNotif        Boolean           @default(false)
  photoUrl          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lat               Float?
  lng               Float?
  wantsLesson       Boolean           @default(false)
  lessonSport       String?
  lessonLevel       String?
  lessonDate        DateTime?
  lessonPlace       String?
  lessonStudentCount Int?            @default(1)
  incomingDecisions MatchDecision[]   @relation("ProfileAsTarget")
  reports           ProfileReport[]   @relation("ProfileAsReported")
  disciplines       RiderDiscipline[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  businessName String?
  bio          String?
  pricePerHour Int?
  emailNotif   Boolean    @default(false)
  photoUrl     String?
  lat          Float?
  lng          Float?
  radiusKm     Int        @default(25)
  verified     Boolean    @default(false)
  verifiedAt   DateTime?
  notificationPreferences Json?  // { notifyForSurf: true, notifyForKitesurf: true, pushEnabled: true, emailEnabled: false }
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  offers          ProOffer[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Master toggles
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(false)

  // Preferences for Riders
  notifyMessages    Boolean @default(true) // New message notifications
  notifyMatches     Boolean @default(true) // New match notifications
  notifyInvitations Boolean @default(true) // Group invitation notifications

  // Preferences for PROs (all defaults true)
  notifyLessonRequests   Boolean @default(true) // Nearby rider looking for lessons
  notifyBookingAccepted  Boolean @default(true) // Booking request accepted by rider
  notifyBookingRejected  Boolean @default(true) // Booking request rejected by rider
  notifyProMessages      Boolean @default(true) // Messages from riders

  // Sport-specific for PROs
  notifyForSurf     Boolean @default(true)
  notifyForKitesurf Boolean @default(true)

  // Email digest (future)
  emailDigestFrequency String @default("NEVER") // NEVER, DAILY, WEEKLY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  displayName String?
  permissions String[]  @default([])
  allowedIPs  String[]  @default([])  // IPs autorisées pour ce compte admin
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RiderDiscipline {
  id        String       @id @default(uuid())
  profileId String
  sport     String
  level     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([sport, level])
}

model MatchDecision {
  id              String       @id @default(uuid())
  actorUserId     String
  targetProfileId String
  decision        DecisionKind
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  actor           User         @relation("UserAsActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target          RiderProfile @relation("ProfileAsTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, targetProfileId])
  @@index([actorUserId])
  @@index([targetProfileId])
}

model ProfileReport {
  id                String       @id @default(uuid())
  reporterUserId    String
  reportedProfileId String
  reason            String?
  createdAt         DateTime     @default(now())
  reportedProfile   RiderProfile @relation("ProfileAsReported", fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reporter          User         @relation("UserAsReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([reporterUserId])
  @@index([reportedProfileId])
}

model ProAvailability {
  id           String        @id @default(uuid())
  proUserId    String
  sport        Sport
  levels       String[]
  startAt      DateTime
  endAt        DateTime
  capacity     Int           @default(1)
  bookedCount  Int           @default(0)
  status       AvailabilityStatus @default(OPEN)
  spotName     String?
  spotLat      Float?
  spotLng      Float?
  price        Decimal?      @db.Decimal(8, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]     @relation("BookingOnAvailability")
  requests     BookingRequest[] @relation("BookingRequestOnAvailability")
  interactions ProAvailabilityInteraction[] @relation("AvailabilityInteractions")
  pro          User          @relation("ProAvailabilityOnUser", fields: [proUserId], references: [id], onDelete: Cascade)

  @@index([proUserId])
  @@index([sport])
  @@index([startAt])
  @@unique([proUserId, startAt, endAt])
}

model BookingRequest {
  id              String              @id @default(uuid())
  riderUserId     String
  availabilityId  String
  message         String?
  status          BookingRequestStatus @default(PENDING)
  respondedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  rider           User                @relation("BookingRequestOnUser", fields: [riderUserId], references: [id], onDelete: Cascade)
  availability    ProAvailability     @relation("BookingRequestOnAvailability", fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([riderUserId])
  @@index([availabilityId])
  @@unique([riderUserId, availabilityId, status])
}

model Booking {
  id             String          @id @default(uuid())
  availabilityId String
  riderUserId    String
  status         BookingStatus   @default(CONFIRMED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  availability   ProAvailability @relation("BookingOnAvailability", fields: [availabilityId], references: [id], onDelete: Cascade)
  rider          User            @relation("BookingOnUser", fields: [riderUserId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
  @@index([riderUserId])
  @@unique([availabilityId, riderUserId])
}

model ProAvailabilityInteraction {
  id             String          @id @default(uuid())
  availabilityId String
  riderUserId    String
  eventType      InteractionType
  createdAt      DateTime        @default(now())
  availability   ProAvailability @relation("AvailabilityInteractions", fields: [availabilityId], references: [id], onDelete: Cascade)
  rider          User            @relation("RiderAvailabilityInteractions", fields: [riderUserId], references: [id], onDelete: Cascade)

  @@unique([availabilityId, riderUserId, eventType])
  @@index([availabilityId])
  @@index([riderUserId])
  @@index([eventType])
  @@index([createdAt])
}

enum AvailabilityStatus {
  OPEN
  CLOSED
}

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED_RIDER
  CANCELLED_PRO
}

enum InteractionType {
  VIEW
  CLICK
  REQUEST
  BOOKING
}

model Match {
  id             String        @id @default(uuid())
  userOneId      String
  userTwoId      String
  status         MatchStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  conversation   Conversation?
  userOne        User          @relation("UserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo        User          @relation("UserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
}

model Conversation {
  id             String               @id @default(uuid())
  matchId        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  type           ConversationType     @default(RIDER_TO_RIDER)
  directKey      String?              @unique
  match          Match?               @relation(fields: [matchId], references: [id])
  members        ConversationMember[]
  messages       Message[]
  contactRequests ContactRequest[]
  invitations    ConversationInvitation[]

  @@index([type])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  blockedAt      DateTime?
  lastReadAt     DateTime?
  trashedAt      DateTime?
  favoritedAt    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationInvitation {
  id             String                      @id @default(uuid())
  conversationId String
  invitedUserId  String
  invitedBy      String
  status         ConversationInvitationStatus @default(PENDING)
  createdAt      DateTime                    @default(now())
  respondedAt    DateTime?
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  invitedUser    User                        @relation("InvitedToConversation", fields: [invitedUserId], references: [id], onDelete: Cascade)
  inviter        User                        @relation("ConversationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([conversationId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String
  meta           Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ProOffer {
  id           String     @id @default(uuid())
  proProfileId String
  sport        Sport
  level        Level
  title        String
  description  String
  hourlyRate   Decimal    @db.Decimal(5, 2)
  lat          Float
  lng          Float
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  proProfile   ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  clicks       ProOfferClick[]

  @@index([sport, level])
  @@index([lat, lng])
  @@index([isActive])
}

model ProOfferClick {
  id          String   @id @default(uuid())
  proOfferId  String
  riderUserId String
  createdAt   DateTime @default(now())

  proOffer ProOffer @relation(fields: [proOfferId], references: [id], onDelete: Cascade)
  rider    User     @relation(fields: [riderUserId], references: [id], onDelete: Cascade)

  @@unique([proOfferId, riderUserId])
  @@index([proOfferId])
}

model ContactRequest {
  id             String              @id @default(uuid())
  proUserId      String
  conversationId String
  message        String?
  status         ContactRequestStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  pro            User                @relation("ProContactRequests", fields: [proUserId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responses      ContactRequestResponse[]

  @@index([proUserId])
  @@index([conversationId])
  @@index([status])
}

model ContactRequestResponse {
  id               String         @id @default(uuid())
  contactRequestId String
  riderUserId      String
  response         ContactResponse
  createdAt        DateTime       @default(now())
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  rider            User           @relation("RiderContactResponses", fields: [riderUserId], references: [id], onDelete: Cascade)

  @@unique([contactRequestId, riderUserId])
  @@index([contactRequestId])
  @@index([riderUserId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}

model SystemAlert {
  id             String        @id @default(uuid())
  type           String
  message        String
  severity       AlertSeverity @default(INFO)
  status         AlertStatus   @default(OPEN)
  link           String?
  dedupeKey      String?
  metadata       Json?
  createdById    String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy User? @relation("UserSystemAlerts", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([dedupeKey])
}

model LegalConsentArchive {
  id             Int       @id @default(autoincrement())
  originalUserId String
  consentedAt    DateTime?
  consentVersion String?
  consentIpHash  String?
  deletedAt      DateTime
  archivedAt     DateTime  @default(now())

  @@unique([originalUserId, deletedAt])
  @@index([originalUserId])
  @@index([consentedAt])
  @@index([archivedAt])
}

enum Role {
  RIDER
  PRO
  ADMIN
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}


enum MatchStatus {
  ACTIVE
  UNMATCHED
}

enum MessageType {
  TEXT
  PROPOSAL
}

enum ConversationType {
  RIDER_TO_RIDER
  RIDER_TO_PRO
  PRO_TO_PRO
  ADMIN_TO_USER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DecisionKind {
  ACCEPT
  REFUSE
}

enum Sport {
  surf
  kitesurf
}

enum Level {
  beginner
  intermediate
  advanced
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContactResponse {
  ACCEPT
  REJECT
}

enum ConversationInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConsentLevel {
  personalized
  npa
  limited
  none
}

enum ConsentSignal {
  granted
  denied
}

enum AnalyticsActorType {
  ANON
  RIDER
  PRO
}

enum AnalyticsEventType {
  RIDER_SEARCH_PROS
  RIDER_BOOKING_REQUEST
  RIDER_MATCH_DECISION
  MESSAGE_SENT
  PRO_BOOKING_RESPONSE
  PRO_PROFILE_UPDATE
  PRO_SLOTS_UPDATE
  PRO_DASHBOARD_OPEN
  BLOBOSPHERE_VIEW
  BLOBOSPHERE_OUTBOUND
  BLOBOSPHERE_SIGNUP
}

model UserConsent {
  id                 String         @id @default(uuid())
  userHash           String         @unique
  consentLevel       ConsentLevel
  ad_storage         ConsentSignal
  ad_user_data       ConsentSignal
  ad_personalization ConsentSignal
  cmpVersion         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([updatedAt])
}

model AnalyticsEvent {
  id          String             @id @default(uuid())
  occurredAt  DateTime
  actorType   AnalyticsActorType
  actorHash   String?
  eventType   AnalyticsEventType
  contentId   String?
  sport       Sport?
  zoneLarge   String?
  metadata    Json?
  consented   Boolean            @default(false)
  dedupeKey   String?            @unique
  createdAt   DateTime           @default(now())

  @@index([occurredAt])
  @@index([actorType])
  @@index([actorHash])
  @@index([eventType])
  @@index([contentId])
  @@index([sport])
  @@index([zoneLarge])
}

model AnalyticsDailyAgg {
  id         String             @id @default(uuid())
  day        DateTime
  actorType  AnalyticsActorType
  eventType  AnalyticsEventType
  contentId  String?
  sport      Sport?
  zoneLarge  String?
  count      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([day, actorType, eventType, contentId, sport, zoneLarge])
  @@index([day])
  @@index([actorType])
  @@index([eventType])
  @@index([contentId])
  @@index([sport])
  @@index([zoneLarge])
}
