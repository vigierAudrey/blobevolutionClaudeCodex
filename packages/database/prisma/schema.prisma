generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  PRO
  ADMIN
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  role             Role           @default(RIDER)
  emailVerified    Boolean        @default(false)
  twoFactorEnabled Boolean        @default(false)
  consentedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  riderProfile     RiderProfile?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime

  @@index([userId])
  @@index([tokenHash])
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum PartnerPref {
  ALL
  WOMEN
  MEN
}

model RiderProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  bio            String?
  sex            Sex          @default(UNSPECIFIED)
  partnerPref    PartnerPref  @default(ALL)
  maxDistanceKm  Int          @default(20)
  emailNotif     Boolean      @default(false)
  photoUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}
