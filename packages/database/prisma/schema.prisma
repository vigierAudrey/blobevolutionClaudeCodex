generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  role                    Role                     @default(RIDER)
  emailVerified           Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  consentedAt             DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  consentVersion          String?
  consentIp               String?
  adminProfile            AdminProfile?
  conversationMembers     ConversationMember[]
  creditTransactions      CreditTransaction[]
  emailVerificationTokens EmailVerificationToken[]
  lastSearch              LastSearch?
  matchesA                Match[]                  @relation("UserOne")
  matchesB                Match[]                  @relation("UserTwo")
  decisions               MatchDecision[]          @relation("UserAsActor")
  messages                Message[]
  passwordResetTokens     PasswordResetToken[]
  proProfile              ProProfile?
  reports                 ProfileReport[]          @relation("UserAsReporter")
  refreshTokens           RefreshToken[]
  riderProfile            RiderProfile?
  sessions                Session[]
  wallet                  UserWallet?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model LastSearch {
  userId     String       @id
  sport      String
  level      String
  partner    PartnerPref?
  distanceKm Int?
  lat        Float?
  lng        Float?
  date       DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model RiderProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  displayName       String?
  bio               String?
  sex               Sex               @default(UNSPECIFIED)
  partnerPref       PartnerPref       @default(ALL)
  maxDistanceKm     Int               @default(20)
  emailNotif        Boolean           @default(false)
  photoUrl          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lat               Float?
  lng               Float?
  wantsLesson       Boolean           @default(false)
  lessonSport       String?
  incomingDecisions MatchDecision[]   @relation("ProfileAsTarget")
  reports           ProfileReport[]   @relation("ProfileAsReported")
  disciplines       RiderDiscipline[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  businessName String?
  bio          String?
  pricePerHour Int?
  emailNotif   Boolean    @default(false)
  photoUrl     String?
  lat          Float?
  lng          Float?
  verified     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  offers       ProOffer[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  displayName String?
  permissions String[]  @default([])
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RiderDiscipline {
  id        String       @id @default(uuid())
  profileId String
  sport     String
  level     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([sport, level])
}

model MatchDecision {
  id              String       @id @default(uuid())
  actorUserId     String
  targetProfileId String
  decision        DecisionKind
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  actor           User         @relation("UserAsActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target          RiderProfile @relation("ProfileAsTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, targetProfileId])
  @@index([actorUserId])
  @@index([targetProfileId])
}

model ProfileReport {
  id                String       @id @default(uuid())
  reporterUserId    String
  reportedProfileId String
  reason            String?
  createdAt         DateTime     @default(now())
  reportedProfile   RiderProfile @relation("ProfileAsReported", fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reporter          User         @relation("UserAsReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([reporterUserId])
  @@index([reportedProfileId])
}

model Match {
  id             String        @id @default(uuid())
  userOneId      String
  userTwoId      String
  status         MatchStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  conversation   Conversation?
  userOne        User          @relation("UserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo        User          @relation("UserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
}

model Conversation {
  id        String               @id @default(uuid())
  matchId   String?              @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  type      ConversationType     @default(RIDER_TO_RIDER)
  match     Match?               @relation(fields: [matchId], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@index([type])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  blockedAt      DateTime?
  lastReadAt     DateTime?
  trashedAt      DateTime?
  favoritedAt    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String
  meta           Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ProOffer {
  id           String     @id @default(uuid())
  proProfileId String
  sport        Sport
  level        Level
  title        String
  description  String
  hourlyRate   Decimal    @db.Decimal(5, 2)
  lat          Float
  lng          Float
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  proProfile   ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  @@index([sport, level])
  @@index([lat, lng])
  @@index([isActive])
  @@index([proProfileId])
}

model UserWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTransaction {
  id            String                @id @default(uuid())
  userId        String
  type          CreditTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  balanceBefore Decimal               @db.Decimal(10, 2)
  balanceAfter  Decimal               @db.Decimal(10, 2)
  description   String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  RIDER
  PRO
  ADMIN
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum PartnerPref {
  ALL
  WOMEN
  MEN
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
}

enum MessageType {
  TEXT
  PROPOSAL
}

enum ConversationType {
  RIDER_TO_RIDER
  RIDER_TO_PRO
  PRO_TO_PRO
}

enum DecisionKind {
  ACCEPT
  REFUSE
}

enum Sport {
  surf
  kitesurf
}

enum Level {
  beginner
  intermediate
  advanced
}

enum CreditTransactionType {
  WELCOME_BONUS
  ADMIN_GRANT
  LESSON_BOOKING
  LESSON_REFUND
  PROMO_BONUS
  REFERRAL_BONUS
}
