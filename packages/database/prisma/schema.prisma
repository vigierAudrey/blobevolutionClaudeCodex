generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  PRO
  ADMIN
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  role             Role           @default(RIDER)
  emailVerified    Boolean        @default(false)
  twoFactorEnabled Boolean        @default(false)
  consentedAt      DateTime?
  consentVersion   String?
  consentIp        String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  riderProfile     RiderProfile?
  proProfile       ProProfile?
  lastSearch       LastSearch?
  decisions        MatchDecision[] @relation("UserAsActor")
  reports          ProfileReport[] @relation("UserAsReporter")
  matchesA         Match[]         @relation("UserOne")
  matchesB         Match[]         @relation("UserTwo")
  conversationMembers ConversationMember[]
  messages         Message[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime

  @@index([userId])
  @@index([tokenHash])
}

model LastSearch {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport      String
  level      String
  partner    PartnerPref?
  distanceKm Int?
  lat        Float?
  lng        Float?
  date       DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum PartnerPref {
  ALL
  WOMEN
  MEN
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
}

enum MessageType {
  TEXT
  PROPOSAL
}

model RiderProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  bio            String?
  sex            Sex          @default(UNSPECIFIED)
  partnerPref    PartnerPref  @default(ALL)
  maxDistanceKm  Int          @default(20)
  emailNotif     Boolean      @default(false)
  photoUrl       String?
  lat            Float?
  lng            Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  disciplines    RiderDiscipline[]
  incomingDecisions MatchDecision[] @relation("ProfileAsTarget")
  reports            ProfileReport[] @relation("ProfileAsReported")

  @@index([userId])
}

model ProProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String?
  bio            String?
  pricePerHour   Int?
  emailNotif     Boolean  @default(false)
  photoUrl       String?
  lat            Float?
  lng            Float?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model RiderDiscipline {
  id        String        @id @default(uuid())
  profileId String
  profile   RiderProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sport     String
  level     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([profileId])
  @@index([sport, level])
}

enum DecisionKind {
  ACCEPT
  REFUSE
}

model MatchDecision {
  id              String       @id @default(uuid())
  actorUserId     String
  actor           User         @relation("UserAsActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetProfileId String
  target          RiderProfile @relation("ProfileAsTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)
  decision        DecisionKind
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([actorUserId, targetProfileId])
  @@index([actorUserId])
  @@index([targetProfileId])
}

model ProfileReport {
  id                String       @id @default(uuid())
  reporterUserId    String
  reporter          User         @relation("UserAsReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedProfileId String
  reportedProfile   RiderProfile @relation("ProfileAsReported", fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reason            String?
  createdAt         DateTime     @default(now())

  @@index([reporterUserId])
  @@index([reportedProfileId])
}

// A mutual accept creates a Match and a direct Conversation.
model Match {
  id            String      @id @default(uuid())
  userOneId     String
  userTwoId     String
  userOne       User        @relation("UserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo       User        @relation("UserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  status        MatchStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  lastActivityAt DateTime   @default(now())
  conversation  Conversation?

  @@unique([userOneId, userTwoId])
}

model Conversation {
  id         String                @id @default(uuid())
  matchId    String?               @unique
  match      Match?                @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  members    ConversationMember[]
  messages   Message[]
}

model ConversationMember {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockedAt      DateTime?
  lastReadAt     DateTime?
  trashedAt      DateTime?
  favoritedAt    DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType   @default(TEXT)
  content        String
  meta           Json?
  createdAt      DateTime      @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}
