model UserConsent {
  id                 String         @id @default(uuid())
  userHash           String         @unique  // HMAC-SHA256(rawToken, CONSENT_HMAC_SECRET) — jamais le token brut
  consentLevel       ConsentLevel
  ad_storage         ConsentSignal
  ad_user_data       ConsentSignal
  ad_personalization ConsentSignal
  cmpVersion         String?
  // P2-C: token fort — expiration + one-time write
  tokenExpiresAt     DateTime?      // null = pas de contrainte (legacy); mis à +30j à la création
  tokenUsedAt        DateTime?      // positionné après un write; rejet si != null
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([updatedAt])
  @@index([tokenExpiresAt])
}

model AnalyticsEvent {
  id          String             @id @default(uuid())
  occurredAt  DateTime
  actorType   AnalyticsActorType
  actorHash   String?
  eventType   AnalyticsEventType
  contentId   String?
  sport       Sport?
  zoneLarge   String?
  metadata    Json?
  consented   Boolean            @default(false)
  dedupeKey   String?            @unique
  createdAt   DateTime           @default(now())

  @@index([occurredAt])
  @@index([actorType])
  @@index([actorHash])
  @@index([eventType])
  @@index([contentId])
  @@index([sport])
  @@index([zoneLarge])
}


model AnalyticsDailyAgg {
  id         String             @id @default(uuid())
  day        DateTime
  actorType  AnalyticsActorType
  eventType  AnalyticsEventType
  contentId  String?
  sport      Sport?
  zoneLarge  String?
  count      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([day, actorType, eventType, contentId, sport, zoneLarge])
  @@index([day])
  @@index([actorType])
  @@index([eventType])
  @@index([contentId])
  @@index([sport])
  @@index([zoneLarge])
}

// Observabilité opérationnelle des fanouts de notifications cours.
// Une ligne par déclenchement (cooldowns bloqués exclus).
// riderRef : SHA-256 tronqué — non-réversible, jamais retourné au client.
model LessonFanout {
  id              String   @id @default(cuid())
  riderRef        String
  // sha256(riderId + UTC-date)[:16] — un rider peut déclencher N fanouts/jour
  // pour la même demande active (cooldown 1h). Ce champ permet COUNT(DISTINCT)
  // pour mesurer les demandes uniques par rider-jour plutôt que les fanouts bruts.
  lessonRequestId String
  sport           String?
  prosFound       Int      @default(0)
  prosNotified    Int      @default(0)
  failureCount    Int      @default(0)
  // Raison du déclenchement : ACTIVATED | LOCATION_CHANGED | SPORT_CHANGED | MANUAL.
  // NULL pour les lignes antérieures au sprint Data Quality (2026-05-20).
  triggerReason   String?
  // Zone géographique large (grille 1° ≈ 111 km) — ex: "Z43:-2".
  // NULL pour les lignes antérieures au sprint C7 (2026-05-23).
  // Calculée au moment du fanout depuis lessonLat/lessonLng (non stockés pour privacy).
  zoneLarge       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([lessonRequestId])
}
