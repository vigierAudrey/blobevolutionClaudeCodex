{
  "name": "@blobinfini/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "generate": "prisma generate",
    "db:push": "prisma db push --skip-generate --accept-data-loss --schema prisma/schema.prisma",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "reseed": "tsx prisma/reseed.ts",
    "reset": "prisma migrate reset --force",
    "reset:seedless": "prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcrypt": "^6.0.0",
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^5.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
