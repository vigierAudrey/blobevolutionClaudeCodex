# .env.pre-vps.example — Environnement pré-VPS BlobConnect
#
# Copier vers .env.pre-vps et remplir les valeurs manquantes.
# JAMAIS commiter .env.pre-vps dans git.
# JAMAIS utiliser ces valeurs en production réelle.
#
# Générer les secrets forts :
#   ./scripts/generate-secrets.sh --pre-vps >> .env.pre-vps
#
# Lancer le bootstrap complet :
#   ./scripts/pre-vps-bootstrap.sh

# ─── Garde anti-confusion d'environnement ────────────────────────────────────
# OBLIGATOIRE : identifie cet env comme pré-VPS (active les exceptions de validation)
APP_ENV=pre-vps
NODE_ENV=production

# ─── Base de données (réseau Docker interne — pas de SSL inter-containers) ───
POSTGRES_USER=blobinfini_pvps
POSTGRES_PASSWORD=CHANGEME_fort_32chars_minimum
POSTGRES_DB=blobinfini_pvps
# DATABASE_URL est injecté par docker-compose depuis les vars ci-dessus.
# Si vous lancez prisma migrate deploy en dehors de Docker, utilisez :
# DATABASE_URL=postgresql://blobinfini_pvps:CHANGEME@localhost:5432/blobinfini_pvps
# (port non exposé — voir docker-compose.pre-vps.yml, utiliser docker exec ou tunnel)

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_redis_fort_32chars
# REDIS_URL est injecté par docker-compose.

# ─── Secrets d'authentification (TOUS obligatoires, TOUS distincts) ───────────
SESSION_SECRET=CHANGEME_session_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=CHANGEME_jwt_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGEME_jwt_refresh_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxx
TWO_FACTOR_SECRET=CHANGEME_2fa_secret_32chars_minimum_xxxxxxxxxx
IP_HASH_SECRET=CHANGEME_ip_hash_secret_32chars_minimum_xxxxxxxxxx_different_from_2fa
EMAIL_HASH_SECRET=CHANGEME_email_hash_secret_32chars_minimum_xxxxxxxxxx_different_from_ip
CONSENT_WRITE_SECRET=CHANGEME_consent_write_secret_64chars_minimum_xxxxxxxxxxxxxxxxxx
LOG_ACTOR_SECRET=CHANGEME_log_actor_secret_64chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Trust proxy (réseau docker 172.20.0.0/16 = nginx container) ─────────────
TRUST_PROXY_MODE=ips
TRUSTED_PROXY_IPS=172.20.0.0/16

# ─── CORS (domaines locaux mkcert) ───────────────────────────────────────────
ALLOWED_ORIGINS=https://app.blobinfini.local

# ─── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_REQUIRE_VERIFIED=true OBLIGATOIRE pour /security/health SAFE en NODE_ENV=production.
# Le seed pre-vps crée tous les comptes avec emailVerified:true — smoke-test compatible.
AUTH_REQUIRE_2FA=false
AUTH_REQUIRE_VERIFIED=true
LOGINATTEMPT_STORE_PLAINTEXT_EMAIL=false

# ─── Admin ────────────────────────────────────────────────────────────────────
PRIMARY_ADMIN_EMAILS=admin@pre-vps.blobinfini.local

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.blobinfini.local
WEB_BASE_URL=https://app.blobinfini.local

# ─── SMTP (Mailpit docker interne) ───────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@pre-vps.blobinfini.local
SMTP_ALLOW_NO_AUTH=true

# ─── S3 / MinIO (docker interne, credentials non-minioadmin) ─────────────────
# S3_ENDPOINT  : accès interne API → MinIO (nom de service Docker, ne pas changer).
# S3_PRESIGN_ENDPOINT / S3_PUBLIC_URL_BASE : URL côté CLIENT (navigateur).
#   pre-VPS  : http://localhost:9000 (port exposé sur 127.0.0.1, OK dev local).
#   VPS réel : remplacer par l'URL publique derrière nginx + TLS,
#              ex: https://storage.blobinfini.fr  (MinIO non exposé directement)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pvps-access-key
S3_SECRET_ACCESS_KEY=CHANGEME_minio_secret_32chars_minimum
S3_BUCKET=blobinfini-pvps
S3_PUBLIC_URL_BASE=http://localhost:9000/blobinfini-pvps

# ─── Chemin des certs mkcert (monté dans nginx) ───────────────────────────────
MKCERT_CERTS_DIR=./docker/certs/pre-vps

# ─── Observabilité minimale ───────────────────────────────────────────────────
METRICS_INTERNAL_TOKEN=CHANGEME_metrics_token_32chars_minimum
# Header : X-Security-Monitor-Token (≠ X-Internal-Token de /internal/metrics)
SECURITY_MONITOR_TOKEN=CHANGEME_security_monitor_token_32chars
# Désactiver Sentry en pré-VPS (évite la pollution du projet Sentry prod)
SENTRY_DSN=

# ─── GDPR / Rétention ────────────────────────────────────────────────────────
# ANONYMIZATION_SALT : utilisé par booking-archive.ts et gdpr-purge.service.ts pour
# hacher les données avant archivage RGPD. Fallback insécure 'blobinfini-gdpr-salt'
# si absent — OBLIGATOIRE en pré-VPS pour éviter des hashes prédictibles.
ANONYMIZATION_SALT=CHANGEME_gdpr_anonymization_salt_32chars_xxxxxxxxxx
GDPR_PURGE_INTERVAL_HOURS=24
CONV_TRASH_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# ─── Rate limiting ────────────────────────────────────────────────────────────
# NE PAS désactiver en pré-VPS — tester le comportement réel
# RATE_LIMIT_DISABLED_FOR_BOOKING_REQUESTS=false  ← ne pas décommenter

# ─── CSP ──────────────────────────────────────────────────────────────────────
CSP_REPORT_ONLY=true

# ─── Divers ───────────────────────────────────────────────────────────────────
PORT=4000
ADMIN_REFRESH_TTL_HOURS=8
